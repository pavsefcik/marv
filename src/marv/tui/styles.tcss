/* marv TUI theme — quiet, terminal-native.
 *
 * Colors are referenced through theme variables only ($primary, $text-muted,
 * ...) so switching themes (ansi-dark/ansi-light/nord/minimal) needs no CSS
 * change. Under the ANSI themes $surface/$panel resolve to transparent, so no
 * rule here may rely on them for contrast.
 *
 * Layout idea: transparent chrome, thin rules instead of boxes, glyph+verb
 * tool rows, and a two-line footer.
 */

* {
    scrollbar-size: 1 1;
}

Screen {
    background: $background;
}

#main-container {
    height: 1fr;
}

#chat-view {
    height: 1fr;
    width: 1fr;
    padding: 0 2;
    background: transparent;
    scrollbar-size: 1 1;
}

.extension-slot {
    background: transparent;
    color: $foreground-muted;
}

.hidden {
    display: none;
}

#extension-right-panel {
    width: 32;
    height: 1fr;
    padding: 1 2;
    background: transparent;
    border-left: solid $panel;
}

#extension-footer {
    dock: bottom;
    height: auto;
    padding: 0 2;
    background: transparent;
    color: $foreground-muted;
}

/* ---------------------------------------------------------------- messages */

/* A prompt is not an answer. The stripe has to be a border rather than a
   background: under the ANSI themes $surface/$panel resolve to transparent, so
   only an opaque colour drawn for the message itself marks it. */
.message-user {
    color: $foreground;
    background: transparent;
    margin: 1 0 0 0;
    padding: 0 0 0 1;
    width: 100%;
    border-left: tall $primary;
}

.message-assistant {
    color: $foreground;
    margin: 1 0 0 0;
    padding: 0 0 0 2;
    background: transparent;
}

.message-system {
    color: $text-disabled;
    margin: 1 0 0 0;
    padding: 0;
    background: transparent;
}

/* ------------------------------------------------------------- tool calls */

.tool-widget {
    margin: 1 0 0 0;
    padding: 0 0 0 2;
    background: transparent;
    color: $foreground;
    height: auto;
}

.tool-widget.tool-collapsed {
    height: auto;
    min-height: 1;
}

.tool-widget.tool-collapsed:hover {
    background: $panel;
}

.skill-widget {
    margin: 1 0 0 0;
    padding: 0 0 0 2;
    background: transparent;
    color: $foreground;
    height: auto;
}

.skill-widget.skill-collapsed {
    height: auto;
    min-height: 1;
}

.skill-widget.skill-collapsed:hover {
    background: $panel;
}

.tool-result {
    color: $text-muted;
}

/* -------------------------------------------------------------- thinking */

.thinking-widget {
    margin: 1 0 0 0;
    padding: 0 0 0 2;
    background: transparent;
    color: $text-muted;
    height: auto;
}

.thinking-widget.thinking-collapsed {
    height: auto;
    min-height: 1;
}

.thinking-widget.thinking-collapsed:hover {
    background: $panel;
}

/* ------------------------------------------------------------------ input */

#input-container {
    height: auto;
    dock: bottom;
    padding: 0 2 1 2;
    background: $background;
}

#prompt-input {
    height: auto;
}

#prompt-inner {
    border: none;
    border-top: solid $foreground-muted;
    border-bottom: solid $foreground-muted;
    background: transparent;
    padding: 0 1;
    height: auto;
    min-height: 1;
    max-height: 12;
}

/* Textual's TextArea falls back to `theme.surface` (a Rich colour) when its own
   background resolves transparent. marv's surface is transparent too, which
   Rich cannot express, so the prompt pins the terminal default instead. */
.-theme-marv-mlx #prompt-inner {
    background: ansi_default;
}

#prompt-inner:focus {
    border: none;
    border-top: solid $primary;
    border-bottom: solid $primary;
}

/* A descendant selector, not `>`: component classes are not DOM children, so a
   child combinator never matches and TextArea's own default ($text 40%) wins. */
#prompt-inner .text-area--placeholder {
    color: $text-disabled;
}

/* The ANSI themes resolve `$text-disabled` to `ansi_default 50%`, and ANSI has
   no alpha, so it collapses to the terminal's default foreground (white). A
   prompt must be grey there too, so use the ever-present bright black. */
#prompt-inner:ansi .text-area--placeholder {
    color: ansi_bright_black;
}

#suggestions {
    overlay: screen;
    height: auto;
    max-height: 10;
    width: 40;
    border: solid $secondary;
    background: $surface;
    offset: 0 -13;
}

#suggestions > .option-list--option-highlighted {
    background: $accent;
}

/* ----------------------------------------------------------------- footer */

#status-line {
    dock: bottom;
    height: 1;
    background: $background;
    color: $text-muted;
    padding: 0 2;
}

#status-left {
    width: 1fr;
    color: $text-muted;
    overflow: hidden;
    text-overflow: ellipsis;
}

#status-right {
    width: auto;
    max-width: 24;
    text-align: right;
    color: $text-muted;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ------------------------------------------------------ input-docked menus */
/* Pickers and prompts replace the prompt input line: they render between the
   two rules around the input (same borders, growing upward as needed) instead
   of floating over the chat. */

.inline-panel {
    height: auto;
    background: transparent;
    border-top: solid $primary;
    border-bottom: solid $primary;
    padding: 0 1;
}

.panel-title {
    color: $secondary;
    text-style: bold;
}

.panel-subtitle {
    color: $foreground-muted;
}

.panel-empty {
    color: $text-disabled;
    padding: 1 0;
}

.panel-hint {
    color: $text-disabled;
}

.panel-menu {
    height: auto;
    max-height: 10;
    background: transparent;
}

.panel-menu > .option-list--option-highlighted {
    background: $accent;
}

/* Model menu */
#model-info {
    min-height: 1;
}

/* Context menu */
#context-scroll {
    height: auto;
    max-height: 24;
}

#summary-content,
#messages-content,
#system-content {
    padding: 0 1;
}

/* Download menu */

/* Two-line entries — taller so they are not clipped. */
#download-options {
    max-height: 14;
}

#download-custom,
#extension-prompt-input {
    background: transparent;
    border: none;
    padding: 0;
    width: 100%;
}

#download-bar {
    width: 100%;
}

/* Extension presented views */
#extension-presented-scroll {
    height: auto;
    max-height: 18;
}

.extension-presented-control-label {
    color: $secondary;
}

.extension-presented-select-content {
    height: auto;
    max-height: 8;
}

.extension-modal-actions {
    width: 100%;
    height: auto;
    align-horizontal: left;
}

.extension-modal-actions Button {
    margin-right: 1;
}

/* A fenced code block is a framed body, not a scroller. Textual reserves a
   horizontal scrollbar row even when the code fits, which surfaced as a black
   bar *below* the code; the frame itself also vanished under the ANSI themes
   (ANSI has no alpha for Textual's default `black 10%`). */
MarkdownFence {
    scrollbar-size-horizontal: 0;
}

/* Textual's ANSI variant drops the fence margin and side padding, so code
   blocks (and the headings around them) sit differently from every hex theme.
   Keep the frame geometry identical and only swap in an opaque background. */
MarkdownFence:ansi {
    margin: 1 0;
    background: ansi_bright_black;
}

MarkdownFence:ansi > Label {
    padding: 1 2;
}
